# Copie este arquivo para .env e ajuste os valores

# Porta do servidor
PORT=3000

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=vistoria_informatizada

# Autenticação (troque por um texto longo e aleatório)
JWT_SECRET=troque_este_segredo
JWT_EXPIRES_IN=8h
